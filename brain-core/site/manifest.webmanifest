{
  "id": "/",
  "name": "Sovereign SG16 Brain",
  "short_name": "SG16 Brain",
  "description": "Self-hosted SG16 Brain: chat in your own language, coding help, and an API for your own projects.",
  "start_url": "/",
  "scope": "/",
  "display": "standalone",
  "display_override": ["standalone", "minimal-ui"],
  "orientation": "any",
