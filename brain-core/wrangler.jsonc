{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "sg16-brain-core",
  "main": "src/index.ts",
  "compatibility_date": "2026-09-01",

  "observability": { "enabled": true },

  "kv_namespaces": [
    { "binding": "KEYS", "id": "9a3ddaf967d843f18614ecd6b785a186" }
  ],

  "d1_databases": [
    { "binding": "LOGS", "database_name": "sg16_logs", "database_id": "e0080774-8693-4841-9a5b-4d7e8cf3037c" }
  ],

  "durable_objects": {
    "bindings": [
      { "name": "QUEUE", "class_name": "InferenceQueueDO" },
      { "name": "MATRIX", "class_name": "MatrixDO" }
    ]
  },
  "migrations": [
    { "tag": "v1", "new_sqlite_classes": ["InferenceQueueDO", "MatrixDO"] }
  ],

  "vars": {
    "MODEL_URL": "https://internal.mistralbrain.com",
    "MODEL_PROVIDER": "ollama",
    "MODEL_NAME": "devstral",
    "MODEL_HEALTH_PATH": "/api/tags",
    "MODEL_NUM_CTX": "8192",
    "MISTRAL_MODEL": "mistral-small-latest",
    "MAX_OUTPUT_CHARS": "16384",
    "INFERENCE_TIMEOUT_MS": "60000",
    "MAX_QUEUE_WAIT_MS": "45000"
  }
}
