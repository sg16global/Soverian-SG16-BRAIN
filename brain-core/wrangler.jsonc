{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "sg16-brain-core",
  "main": "src/index.ts",
  "compatibility_date": "2026-09-01",
  "compatibility_flags": ["nodejs_compat"],


  "observability": { "enabled": true },

  "routes": ["mistralbrain.com/*", "www.mistralbrain.com/*"],

  "assets": {
    "directory": "./client",
    "binding": "ASSETS",
    "run_worker_first": ["/*"]
  },

  "kv_namespaces": [
    { "binding": "KEYS", "id": "9a3ddaf967d843f18614ecd6b785a186" }
  ],

  "d1_databases": [
    { "binding": "LOGS", "database_name": "sg16_logs", "database_id": "e0080774-8693-4841-9a5b-4d7e8cf3037c" }
  ],

  "durable_objects": {
    "bindings": [
      { "name": "QUEUE", "class_name": "InferenceQueueDO" },
      { "name": "MATRIX", "class_name": "MatrixDO" }
    ]
  },
  "migrations": [
    { "tag": "v1", "new_sqlite_classes": ["InferenceQueueDO", "MatrixDO"] }
  ],

  "vars": {
    "MODEL_URL": "https://model.internal.mistralbrain.com",
    "MODEL_PROVIDER": "ollama",
    "MODEL_NAME": "qwen2.5:1.5b-instruct-fp16",
    "MODEL_NAME_CODER": "qwen2.5-coder:7b-instruct-q8_0",
    "MODEL_HEALTH_PATH": "/api/tags",
    "MODEL_NUM_CTX": "8192",
    "MAX_OUTPUT_CHARS": "16384",
    "INFERENCE_TIMEOUT_MS": "60000",
    "MAX_QUEUE_WAIT_MS": "120000",
    "DODO_TEST_MODE": "false",
    "DODO_PRODUCT_IDS": "{\"day\":\"pdt_0NoUNgIwv3XfCVptVxLaa\",\"week\":\"pdt_0NoUNgD5Yjz1cRYOwIixQ\",\"half\":\"pdt_0NoUNg8AK64S8TkG2b5tK\",\"month\":\"pdt_0NoUNg3MglpZRU2yPvduq\"}",
    "ALLOWED_RETURN_ORIGINS": "https://mistralbrain.com"
  }
}
