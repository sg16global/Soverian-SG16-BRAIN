# ── Persistence ──────────────────────────────────────────────────────────────
# Production path. When unset, the app boots a sovereign in-memory PostgreSQL
# (drizzle migrations applied automatically) so the stack runs air-gapped.
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5432/app_db

# ── SG16 core brain ───────────────────────────────────────────────────────────
# Server-side only gateway target (the browser never sees this URL).
# Defaults to the core host in config/brain.json (loopback:8080).
SG16_BRAIN_URL=http://127.0.0.1:8080

# Hard timeout for any single call to the core, in milliseconds (min 1000).
SG16_BRAIN_TIMEOUT_MS=15000

# ── Ollama heart-bridge (optional, second in the fallback ladder) ────────────
# When the Q16.16 core is unreachable, the platform can keep answering from a
# local Ollama daemon on the operator's own metal — zero vendor APIs, zero
# per-token cost, nothing leaving the host. Leave SG16_OLLAMA_URL unset to keep
# the bridge inert. The URL is used server-side and never sent to a browser.
#   ollama pull mistral
# SG16_OLLAMA_URL=http://127.0.0.1:11434
# SG16_OLLAMA_MODEL=mistral
# SG16_OLLAMA_TIMEOUT_MS=45000
# SG16_OLLAMA_ENABLED=0        # hard-off switch, even if the URL is set

# ── Identity signing secret ──────────────────────────────────────────────────
# Set in production so sovereign tokens survive a restart. Unset in dev, a boot
# secret is derived (in-memory anyway).
# SG16_IDENTITY_SECRET=

# ── Optional external model relays (used by /api chat relay personas) ─────────
# OPENAI_API_KEY=
# GEMINI_API_KEY=
# ANTHROPIC_API_KEY=

# ── Code sandbox (POST /api/run, operator + project keys only) ──────────────
# Off by default. Needs Docker on the host and the images pulled beforehand:
#   docker pull python:3.12-alpine && docker pull node:22-alpine
# SG16_SANDBOX_ENABLED=1
# SG16_SANDBOX_CONCURRENCY=2
# SG16_SANDBOX_PYTHON_IMAGE=python:3.12-alpine
# SG16_SANDBOX_NODE_IMAGE=node:22-alpine
